# ==============================================================================
# VYORA — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=VYORA
APP_VERSION=1.0.0-MVP

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite fallback in development/testing: sqlite+aiosqlite:///./vyora.db or sqlite:///./vyora.db
DATABASE_URL=postgresql://vyora_user:vyora_password@localhost:5432/vyora_db
DATABASE_TEST_URL=sqlite:///./vyora_test.db

# Security & Authentication (JWT & Argon2id)
# Generate high-entropy secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-very-secure-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Provider (Google Gemini API via official SDK / REST)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL_NAME=gemini-1.5-pro
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=15

# Logging & Monitoring
LOG_LEVEL=INFO
